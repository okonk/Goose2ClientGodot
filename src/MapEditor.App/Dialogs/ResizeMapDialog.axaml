<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MapEditor.App.Dialogs.ResizeMapDialog"
        Title="Resize Map"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="West" Classes="muted"/>
                <TextBox Name="WestBox" Width="80" HorizontalContentAlignment="Right"/>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="North" Classes="muted"/>
                <TextBox Name="NorthBox" Width="80" HorizontalContentAlignment="Right"/>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="East" Classes="muted"/>
                <TextBox Name="EastBox" Width="80" HorizontalContentAlignment="Right"/>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="South" Classes="muted"/>
                <TextBox Name="SouthBox" Width="80" HorizontalContentAlignment="Right"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="Width" Classes="muted"/>
                <TextBox Name="WidthBox" Width="80" HorizontalContentAlignment="Right"/>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Height" Classes="muted"/>
                <TextBox Name="HeightBox" Width="80" HorizontalContentAlignment="Right"/>
            </StackPanel>
        </StackPanel>
        <TextBlock Name="SizeText" Classes="mono"/>
        <TextBlock Name="DiscardText" Foreground="{DynamicResource EditorDangerBrush}" IsVisible="False"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="ResizeButton" Classes="accent" Content="Resize" MinWidth="84" IsDefault="True"/>
            <Button Name="CancelButton" Content="Cancel" MinWidth="84" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
