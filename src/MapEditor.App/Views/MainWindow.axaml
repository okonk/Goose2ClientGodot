<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MapEditor.App.MainWindow"
        Title="Goose2 Map Editor — Untitled"
        Width="1200"
        Height="800">
  <DockPanel x:Name="Root">
    <Menu x:Name="Menu" DockPanel.Dock="Top">
      <MenuItem x:Name="FileMenu" Header="_File">
        <MenuItem x:Name="NewCommand" Header="_New" Click="OnNew" />
        <MenuItem x:Name="OpenCommand" Header="_Open" Click="OnOpen" />
        <MenuItem x:Name="SaveCommand" Header="_Save" IsEnabled="{Binding CanSave}" Click="OnSave" />
        <MenuItem x:Name="SaveAsCommand" Header="Save _As" Click="OnSaveAs" />
        <Separator />
        <MenuItem x:Name="ExitCommand" Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem x:Name="EditMenu" Header="_Edit">
        <MenuItem x:Name="UndoCommand" Header="_Undo" IsEnabled="{Binding CanUndo}" Click="OnUndo" />
        <MenuItem x:Name="RedoCommand" Header="_Redo" IsEnabled="{Binding CanRedo}" Click="OnRedo" />
      </MenuItem>
      <MenuItem x:Name="ViewMenu" Header="_View">
        <MenuItem x:Name="GridMenuItem" Header="Grid" ToggleType="CheckBox" IsChecked="{Binding ShowGrid, Mode=TwoWay}" />
        <MenuItem x:Name="BlockedMenuItem" Header="Blocked" ToggleType="CheckBox" IsChecked="{Binding ShowBlocked, Mode=TwoWay}" />
      </MenuItem>
    </Menu>
    <Border x:Name="Toolbar" DockPanel.Dock="Top" Padding="4" BorderBrush="#FFCCCCCC" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <ToggleButton x:Name="PencilTool" Content="Pencil" Tag="Pencil" IsChecked="True" Checked="OnToolChecked" Unchecked="OnToolUnchecked" />
        <ToggleButton x:Name="EraserTool" Content="Eraser" Tag="Eraser" Checked="OnToolChecked" Unchecked="OnToolUnchecked" />
        <ToggleButton x:Name="EyedropperTool" Content="Eyedropper" Tag="Eyedropper" Checked="OnToolChecked" Unchecked="OnToolUnchecked" />
        <ToggleButton x:Name="BlockedTool" Content="Blocked" Tag="BlockedToggle" Checked="OnToolChecked" Unchecked="OnToolUnchecked" />
        <ToggleButton x:Name="SelectTool" Content="Select" Tag="Select" Checked="OnToolChecked" Unchecked="OnToolUnchecked" />
        <ToggleButton x:Name="MultiSelectTool" Content="Multi-select" Tag="MultiSelect" Checked="OnToolChecked" Unchecked="OnToolUnchecked" />
        <ToggleButton x:Name="FloodFillTool" Content="Flood fill" Tag="FloodFill" Checked="OnToolChecked" Unchecked="OnToolUnchecked" />
      </StackPanel>
    </Border>
    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Padding="8,3" BorderBrush="#FFCCCCCC" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock x:Name="HoverText" Text="—" />
        <TextBlock x:Name="ZoomText" Text="100%" />
        <TextBlock x:Name="SizeText" Text="100 × 100" />
      </StackPanel>
    </Border>
    <Grid x:Name="Body">
      <Grid.ColumnDefinitions>
        <ColumnDefinition MinWidth="140" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="260" />
      </Grid.ColumnDefinitions>
      <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="4" Background="#FFCCCCCC" />
      <DockPanel x:Name="LeftPanel" Grid.Column="0">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="8">
          <Button x:Name="LoadAssetsButton" Content="Load assets…" Click="OnLoadAssets" />
          <TextBlock x:Name="AssetDirectoryText" Text="—" TextWrapping="Wrap" />
          <ComboBox x:Name="SheetCombo" ItemsSource="{Binding SheetIds}" SelectedItem="{Binding SelectedSheet, Mode=TwoWay}" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="Sheet" VerticalAlignment="Center" />
            <TextBox x:Name="BrushSheet" Width="64" />
            <TextBlock Text="Graphic" VerticalAlignment="Center" />
            <TextBox x:Name="BrushGraphic" Width="64" />
          </StackPanel>
          <TextBlock x:Name="BrushValidationError" Text="Must be a signed integer." Foreground="#FFCC0000" IsVisible="False" />
        </StackPanel>
        <Grid x:Name="PaletteHost" Margin="8,0,8,8" ColumnDefinitions="*,Auto">
          <Border x:Name="PaletteBorder" Grid.Column="0" BorderBrush="#FFCCCCCC" BorderThickness="1" />
          <ScrollBar x:Name="PaletteBar" Grid.Column="1" Orientation="Vertical" />
        </Grid>
      </DockPanel>
      <Border x:Name="CanvasHost" Grid.Column="2" Margin="8" BorderBrush="#FF888888" BorderThickness="1" />
      <StackPanel x:Name="RightPanel" Grid.Column="3" Spacing="4" Margin="8">
        <TextBlock Text="Layers" FontWeight="SemiBold" />
        <Border x:Name="Layer0Row" Tag="0" Background="Transparent" PointerPressed="OnLayerRowPressed">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="Layer0Label" Text="Ground (0)" VerticalAlignment="Center" />
            <CheckBox x:Name="Layer0VisibleCheck" Tag="0" Grid.Column="1" VerticalAlignment="Center"
                      Checked="OnLayerVisibilityChanged" Unchecked="OnLayerVisibilityChanged" />
          </Grid>
        </Border>
        <Border x:Name="Layer1Row" Tag="1" Background="Transparent" PointerPressed="OnLayerRowPressed">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="Layer1Label" Text="Below Entities (1)" VerticalAlignment="Center" />
            <CheckBox x:Name="Layer1VisibleCheck" Tag="1" Grid.Column="1" VerticalAlignment="Center"
                      Checked="OnLayerVisibilityChanged" Unchecked="OnLayerVisibilityChanged" />
          </Grid>
        </Border>
        <Border x:Name="Layer2Row" Tag="2" Background="Transparent" PointerPressed="OnLayerRowPressed">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="Layer2Label" Text="Entities (2)" VerticalAlignment="Center" />
            <CheckBox x:Name="Layer2VisibleCheck" Tag="2" Grid.Column="1" VerticalAlignment="Center"
                      Checked="OnLayerVisibilityChanged" Unchecked="OnLayerVisibilityChanged" />
          </Grid>
        </Border>
        <Border x:Name="Layer3Row" Tag="3" Background="Transparent" PointerPressed="OnLayerRowPressed">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="Layer3Label" Text="Above Entities (3)" VerticalAlignment="Center" />
            <CheckBox x:Name="Layer3VisibleCheck" Tag="3" Grid.Column="1" VerticalAlignment="Center"
                      Checked="OnLayerVisibilityChanged" Unchecked="OnLayerVisibilityChanged" />
          </Grid>
        </Border>
        <Border x:Name="Layer4Row" Tag="4" Background="Transparent" PointerPressed="OnLayerRowPressed">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="Layer4Label" Text="Roof (4)" VerticalAlignment="Center" />
            <CheckBox x:Name="Layer4VisibleCheck" Tag="4" Grid.Column="1" VerticalAlignment="Center"
                      Checked="OnLayerVisibilityChanged" Unchecked="OnLayerVisibilityChanged" />
          </Grid>
        </Border>
        <TextBlock Text="Selected tile" FontWeight="SemiBold" Margin="0,8,0,0" />
        <TextBlock x:Name="SelectedText" Text="—" />
        <TextBlock x:Name="BlockedText" Text="blocked: no" />
        <TextBlock x:Name="Layer0Ref" Text="L0 0/0" />
        <TextBlock x:Name="Layer1Ref" Text="L1 0/0" />
        <TextBlock x:Name="Layer2Ref" Text="L2 0/0" />
        <TextBlock x:Name="Layer3Ref" Text="L3 0/0" />
        <TextBlock x:Name="Layer4Ref" Text="L4 0/0" />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
