<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MapEditor.App.Dialogs.ChoiceDialog"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12" Spacing="12" MinWidth="300">
        <TextBlock Name="MessageText" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="PrimaryButton" MinWidth="80" IsDefault="True"/>
            <Button Name="SecondaryButton" MinWidth="80"/>
            <Button Name="TertiaryButton" MinWidth="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
