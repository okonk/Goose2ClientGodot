<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MapEditor.App.Dialogs.ErrorDialog"
        Title="Error"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="16" MinWidth="320">
        <TextBlock Name="MessageText" TextWrapping="Wrap"/>
        <Button Name="OkButton" Classes="accent" Content="OK" MinWidth="84" HorizontalAlignment="Right" IsDefault="True" IsCancel="True"/>
    </StackPanel>
</Window>
