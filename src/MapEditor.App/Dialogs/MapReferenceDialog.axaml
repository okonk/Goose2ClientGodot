<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MapEditor.App.Dialogs.MapReferenceDialog"
        Title="Confirm map"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource EditorPanelBrush}"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="18" Spacing="14">
    <TextBlock x:Name="Header" TextWrapping="Wrap" MaxWidth="440" />
    <ListBox x:Name="MapList" MinWidth="440" Height="260"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="84" IsCancel="True" Click="OnCancel" />
      <Button x:Name="ConfirmButton" Classes="accent" Content="Confirm" MinWidth="84" IsDefault="True" Click="OnConfirm" />
    </StackPanel>
  </StackPanel>
</Window>
