<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MapEditor.App.Controls"
        xmlns:rows="using:MapEditor.GameData.Rows"
        x:Class="MapEditor.App.MainWindow"
        Title="Goose2 Map Editor — Untitled"
        Width="1200"
        Height="800"
        FontFamily="Inter, $Default">
  <DockPanel x:Name="Root">
    <Menu x:Name="Menu" DockPanel.Dock="Top">
      <MenuItem x:Name="FileMenu" Header="_File">
        <MenuItem x:Name="NewCommand" Header="_New" Click="OnNew" />
        <MenuItem x:Name="OpenCommand" Header="_Open" Click="OnOpen" />
        <MenuItem x:Name="SaveCommand" Header="_Save" IsEnabled="{Binding CanSave}" Click="OnSave" />
        <MenuItem x:Name="SaveAsCommand" Header="Save _As" Click="OnSaveAs" />
        <Separator />
        <MenuItem x:Name="ExitCommand" Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem x:Name="EditMenu" Header="_Edit">
        <MenuItem x:Name="UndoCommand" Header="_Undo" IsEnabled="{Binding CanUndo}" Click="OnUndo" />
        <MenuItem x:Name="RedoCommand" Header="_Redo" IsEnabled="{Binding CanRedo}" Click="OnRedo" />
        <Separator />
        <MenuItem x:Name="ResizeCommand" Header="Resize _Map" Click="OnResize" />
      </MenuItem>
      <MenuItem x:Name="ViewMenu" Header="_View">
        <MenuItem x:Name="GridMenuItem" Header="Grid" ToggleType="CheckBox" IsChecked="{Binding ShowGrid, Mode=TwoWay}" />
        <MenuItem x:Name="BlockedMenuItem" Header="Blocked" ToggleType="CheckBox" IsChecked="{Binding ShowBlocked, Mode=TwoWay}" />
        <Separator />
        <MenuItem x:Name="ThemeMenuItem" Header="_Theme">
          <MenuItem x:Name="DarkThemeMenuItem" Header="Dark" Tag="Dark" ToggleType="Radio" GroupName="EditorTheme" Click="OnThemeSelected" />
          <MenuItem x:Name="LightThemeMenuItem" Header="Light" Tag="Light" ToggleType="Radio" GroupName="EditorTheme" Click="OnThemeSelected" />
        </MenuItem>
      </MenuItem>
      <MenuItem x:Name="GameDataMenu" Header="_Game Data">
        <MenuItem x:Name="ConnectCommand" Header="Connect" Click="OnConnect" />
        <Separator />
        <MenuItem x:Name="PullCommand" Header="Pull" Click="OnPull" />
        <MenuItem x:Name="PushCommand" Header="Push" Click="OnPush" />
        <Separator />
        <MenuItem x:Name="SpawnOverlayMenuItem" Header="Spawn overlay" ToggleType="CheckBox" IsChecked="{Binding GameData.ShowSpawnOverlay, Mode=TwoWay}" />
        <MenuItem x:Name="WarpOverlayMenuItem" Header="Warp overlay" ToggleType="CheckBox" IsChecked="{Binding GameData.ShowWarpOverlay, Mode=TwoWay}" />
        <MenuItem x:Name="PreviewMenuItem" Header="Preview" ToggleType="CheckBox" IsChecked="{Binding GameData.PreviewMode, Mode=TwoWay}" />
        <MenuItem x:Name="ShowNamesMenuItem" Header="Show names" ToggleType="CheckBox" IsChecked="{Binding GameData.ShowNames, Mode=TwoWay}" />
      </MenuItem>
    </Menu>
    <ListBox x:Name="TabStrip" DockPanel.Dock="Top"
             SelectionMode="Single"
             ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Classes="tabHeader" Orientation="Horizontal" Spacing="6" Margin="10,5" MinWidth="72" MaxWidth="180"
                      ToolTip.Tip="{Binding TabToolTip}" PointerPressed="OnTabHeaderPressed">
            <TextBlock Text="{Binding TabTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Ellipse Width="6" Height="6" Fill="{DynamicResource EditorAccentBrush}"
                     IsVisible="{Binding IsDirty}" VerticalAlignment="Center" />
            <Button Classes="tabClose" ToolTip.Tip="Close" PointerPressed="OnTabClosePressed" Click="OnTabCloseClicked"
                    VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Border x:Name="StatusBar" Classes="chrome" DockPanel.Dock="Bottom" Padding="12,5" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="18">
        <TextBlock x:Name="HoverText" Classes="mono muted" Text="—" />
        <TextBlock x:Name="ZoomText" Classes="mono muted" Text="100%" />
        <TextBlock x:Name="SizeText" Classes="mono muted" Text="100 × 100" />
        <TextBlock x:Name="PreviewStatusText" Classes="muted" Text="{Binding PreviewStatus}" IsVisible="{Binding GameData.PreviewMode}" />
      </StackPanel>
    </Border>
    <Grid x:Name="Body">
      <Grid.ColumnDefinitions>
        <ColumnDefinition MinWidth="140" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="260" />
      </Grid.ColumnDefinitions>
      <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="4" />
      <DockPanel x:Name="LeftPanel" Grid.Column="0" Background="{DynamicResource EditorPanelBrush}">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="12,12,12,10">
          <Button x:Name="LoadAssetsButton" Content="Load assets…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnLoadAssets" />
          <TextBlock x:Name="AssetDirectoryText" Classes="muted" FontSize="11" Text="—" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
          <ComboBox x:Name="SheetCombo" ItemsSource="{Binding SheetIds}" SelectedItem="{Binding SelectedSheet, Mode=TwoWay}" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Sheet" Classes="muted" VerticalAlignment="Center" />
            <TextBox x:Name="BrushSheet" Width="58" />
            <TextBlock Text="Graphic" Classes="muted" VerticalAlignment="Center" />
            <TextBox x:Name="BrushGraphic" Width="58" />
          </StackPanel>
          <TextBlock x:Name="BrushValidationError" Text="Must be a signed integer."
                     Foreground="{DynamicResource EditorDangerBrush}" FontSize="11" IsVisible="False" />
        </StackPanel>
        <!-- The scrollbar overlays the palette so the tile grid keeps the full panel width. -->
        <Grid x:Name="PaletteHost" Margin="12,0,12,12">
          <Border x:Name="PaletteBorder" Classes="sunken" ClipToBounds="True" />
          <ScrollBar x:Name="PaletteBar" Classes="overlay" Orientation="Vertical"
                     HorizontalAlignment="Right" Margin="0,3,3,3" IsVisible="False" />
        </Grid>
      </DockPanel>
      <DockPanel Grid.Column="2">
        <!-- A floating tool strip: the toolbar no longer spans the window, so a card reads better than a band.
             Ordered by what the tool does to the map: pick tiles, then sample and paint them, then flag them blocked. -->
        <Border x:Name="Toolbar" Classes="card" DockPanel.Dock="Top"
                Padding="4" Margin="10,10,10,0" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <ToggleButton x:Name="SelectTool" Classes="tool" Tag="Select" Content="{StaticResource IconSelect}" ToolTip.Tip="Select (V)" Checked="OnToolChecked" Unchecked="OnToolUnchecked" />
            <ToggleButton x:Name="MultiSelectTool" Classes="tool" Tag="MultiSelect" Content="{StaticResource IconMultiSelect}" ToolTip.Tip="Multi-select (M)" Checked="OnToolChecked" Unchecked="OnToolUnchecked" />
            <Rectangle Classes="toolSeparator" />
            <ToggleButton x:Name="EyedropperTool" Classes="tool" Tag="Eyedropper" Content="{StaticResource IconEyedropper}" ToolTip.Tip="Eyedropper (I)" Checked="OnToolChecked" Unchecked="OnToolUnchecked" />
            <ToggleButton x:Name="PencilTool" Classes="tool" Tag="Pencil" IsChecked="True" Content="{StaticResource IconPencil}" ToolTip.Tip="Pencil (P)" Checked="OnToolChecked" Unchecked="OnToolUnchecked" />
            <ToggleButton x:Name="EraserTool" Classes="tool" Tag="Eraser" Content="{StaticResource IconEraser}" ToolTip.Tip="Eraser (E)" Checked="OnToolChecked" Unchecked="OnToolUnchecked" />
            <ToggleButton x:Name="FloodFillTool" Classes="tool" Tag="FloodFill" Content="{StaticResource IconFloodFill}" ToolTip.Tip="Flood fill (B)" Checked="OnToolChecked" Unchecked="OnToolUnchecked" />
            <Rectangle Classes="toolSeparator" />
            <ToggleButton x:Name="BlockedTool" Classes="tool" Tag="Blocked" Content="{StaticResource IconBlocked}" ToolTip.Tip="Blocked (X)" Checked="OnToolChecked" Unchecked="OnToolUnchecked" />
            <Rectangle Classes="toolSeparator" />
            <ToggleButton x:Name="SpawnTool" Classes="tool" Tag="Spawn" Content="{StaticResource IconSpawn}" ToolTip.Tip="Spawn" Checked="OnGameToolChecked" Unchecked="OnGameToolUnchecked" />
            <ToggleButton x:Name="WarpTool" Classes="tool" Tag="Warp" Content="{StaticResource IconWarp}" ToolTip.Tip="Warp" Checked="OnGameToolChecked" Unchecked="OnGameToolUnchecked" />
          </StackPanel>
        </Border>
        <Border x:Name="CanvasHost" Classes="sunken" Margin="10,8,10,10" ClipToBounds="True" />
      </DockPanel>
      <Grid x:Name="RightPanelHost" Grid.Column="3" Margin="12" Background="Transparent">
      <StackPanel x:Name="RightPanel" Spacing="0">
        <TextBlock Text="LAYERS" Classes="section" Margin="2,0,0,6" />
        <Border Classes="card">
        <StackPanel>
        <Border x:Name="Layer0Row" Classes="row" Tag="0" Background="Transparent" PointerPressed="OnLayerRowPressed">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="Layer0Label" Text="Ground (0)" VerticalAlignment="Center" />
            <CheckBox x:Name="Layer0VisibleCheck" Tag="0" Grid.Column="1" VerticalAlignment="Center"
                      Checked="OnLayerVisibilityChanged" Unchecked="OnLayerVisibilityChanged" />
          </Grid>
        </Border>
        <Border x:Name="Layer1Row" Classes="row" Tag="1" Background="Transparent" PointerPressed="OnLayerRowPressed">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="Layer1Label" Text="Below Entities (1)" VerticalAlignment="Center" />
            <CheckBox x:Name="Layer1VisibleCheck" Tag="1" Grid.Column="1" VerticalAlignment="Center"
                      Checked="OnLayerVisibilityChanged" Unchecked="OnLayerVisibilityChanged" />
          </Grid>
        </Border>
        <Border x:Name="Layer2Row" Classes="row" Tag="2" Background="Transparent" PointerPressed="OnLayerRowPressed">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="Layer2Label" Text="Entities (2)" VerticalAlignment="Center" />
            <CheckBox x:Name="Layer2VisibleCheck" Tag="2" Grid.Column="1" VerticalAlignment="Center"
                      Checked="OnLayerVisibilityChanged" Unchecked="OnLayerVisibilityChanged" />
          </Grid>
        </Border>
        <Border x:Name="Layer3Row" Classes="row" Tag="3" Background="Transparent" PointerPressed="OnLayerRowPressed">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="Layer3Label" Text="Above Entities (3)" VerticalAlignment="Center" />
            <CheckBox x:Name="Layer3VisibleCheck" Tag="3" Grid.Column="1" VerticalAlignment="Center"
                      Checked="OnLayerVisibilityChanged" Unchecked="OnLayerVisibilityChanged" />
          </Grid>
        </Border>
        <Border x:Name="Layer4Row" Classes="row last" Tag="4" Background="Transparent" PointerPressed="OnLayerRowPressed">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="Layer4Label" Text="Roof (4)" VerticalAlignment="Center" />
            <CheckBox x:Name="Layer4VisibleCheck" Tag="4" Grid.Column="1" VerticalAlignment="Center"
                      Checked="OnLayerVisibilityChanged" Unchecked="OnLayerVisibilityChanged" />
          </Grid>
        </Border>
        </StackPanel>
        </Border>
        <TextBlock Text="SELECTED TILE" Classes="section" Margin="2,18,0,6" />
        <Border Classes="card" Padding="10,8">
          <StackPanel Spacing="3">
            <TextBlock x:Name="SelectedText" Classes="mono" Text="—" />
            <TextBlock x:Name="BlockedText" Classes="mono muted" Margin="0,0,0,5" Text="blocked: no" />
            <TextBlock x:Name="Layer0Ref" Classes="mono muted" Text="L0 0/0" />
            <TextBlock x:Name="Layer1Ref" Classes="mono muted" Text="L1 0/0" />
            <TextBlock x:Name="Layer2Ref" Classes="mono muted" Text="L2 0/0" />
            <TextBlock x:Name="Layer3Ref" Classes="mono muted" Text="L3 0/0" />
            <TextBlock x:Name="Layer4Ref" Classes="mono muted" Text="L4 0/0" />
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel x:Name="SpawnProperties" Spacing="0" IsVisible="False">
        <TextBlock Text="SPAWN" Classes="section" Margin="2,0,0,6" />
        <Border Classes="card" Padding="10,8">
          <StackPanel Spacing="8">
            <TextBlock Text="NPC" Classes="muted" FontSize="11" />
            <controls:SearchPickerControl x:Name="SpawnNpcPicker" x:TypeArguments="rows:NpcAppearance" />
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel x:Name="WarpProperties" Spacing="0" IsVisible="False">
        <TextBlock Text="WARP" Classes="section" Margin="2,0,0,6" />
        <Border Classes="card" Padding="10,8">
          <StackPanel Spacing="8">
            <TextBlock Text="Destination map" Classes="muted" FontSize="11" />
            <controls:SearchPickerControl x:Name="WarpDestinationPicker" x:TypeArguments="rows:MapReference" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Destination" Classes="muted" VerticalAlignment="Center" />
              <TextBox x:Name="WarpDestinationX" Width="58" />
              <TextBox x:Name="WarpDestinationY" Width="58" />
            </StackPanel>
            <Button x:Name="WarpUseSelectedTileButton" Content="Use Selected Tile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="False" Click="OnUseSelectedTile" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    </Grid>
  </DockPanel>
</Window>
