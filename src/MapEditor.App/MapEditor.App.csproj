<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <PublishTrimmed>false</PublishTrimmed>
    <UseAppHost>true</UseAppHost>
    <!-- Dialog windows are always constructed in code with parameterized constructors. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MapEditor.Core/MapEditor.Core.csproj" />
    <ProjectReference Include="../MapEditor.Rendering/MapEditor.Rendering.csproj" />
    <ProjectReference Include="../MapEditor.GameData/MapEditor.GameData.csproj" />
    <ProjectReference Include="../MapEditor.GameData.Google/MapEditor.GameData.Google.csproj" />
  </ItemGroup>
</Project>
