<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MapEditor.App.Dialogs.NewMapDialog"
        Title="New Map"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="Width"/>
                <TextBox Name="WidthBox" Width="80" HorizontalContentAlignment="Right"/>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Height"/>
                <TextBox Name="HeightBox" Width="80" HorizontalContentAlignment="Right"/>
            </StackPanel>
        </StackPanel>
        <TextBlock Name="ErrorText" Foreground="Red" IsVisible="False" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="OkButton" Content="OK" MinWidth="80" IsDefault="True"/>
            <Button Name="CancelButton" Content="Cancel" MinWidth="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
