<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MapEditor.App.Dialogs.SpreadsheetDialog"
        Title="Spreadsheet"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="18" Spacing="16">
    <TextBlock Text="Which spreadsheet holds this map's game data?" TextWrapping="Wrap" />
    <TextBox x:Name="UrlBox" Watermark="Paste the Google spreadsheet URL" MinWidth="420" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="PullButton" Content="Pull" MinWidth="84" IsDefault="True" Click="OnPull" />
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="84" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
