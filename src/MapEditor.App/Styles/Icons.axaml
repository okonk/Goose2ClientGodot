<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Toolbar glyphs. Every icon is drawn as an outline on a 24x24 grid with a ~3px margin,
    so the whole set shares one optical size and one stroke weight once ToolButton scales it.
    Each sub-path starts with an absolute M: a relative m continues from the previous
    sub-path's end point, which silently displaces the shape.
  -->
  <StreamGeometry x:Key="IconPencil">M3.5 20.5 L4.1 16.8 L15.4 5.5 L18.5 8.6 L7.2 19.9 Z M11.8 9 L15 12.2</StreamGeometry>
  <StreamGeometry x:Key="IconEraser">M2.2 16.5 L12.9 5.8 L17.1 10 L6.4 20.7 Z M6.7 12 L10.9 16.2 M7.5 21 L21.5 21</StreamGeometry>
  <StreamGeometry x:Key="IconEyedropper">M3 21 L4 17.8 L11.1 10.7 L9.9 9.6 L14.9 4.6 A3.2 3.2 0 0 1 19.4 9.1 L14.5 14.1 L13.3 12.9 L6.3 20 Z</StreamGeometry>
  <StreamGeometry x:Key="IconBlocked">M12 3 A9 9 0 0 1 12 21 A9 9 0 0 1 12 3 Z M5.6 5.6 L18.4 18.4</StreamGeometry>
  <StreamGeometry x:Key="IconSelect">M5 3 L5 19.5 L9.2 15.5 L11.8 21.3 L14.6 20 L12 14.3 L17.8 14.3 Z</StreamGeometry>
  <!-- Marquee dashes are drawn as explicit segments rather than a StrokeDashArray so the
       corners always land on a dash and the pattern does not shift with the icon scale. -->
  <StreamGeometry x:Key="IconMultiSelect">M3 3 H8 M10.5 3 H13.5 M16 3 H21 M21 3 V8 M21 10.5 V13.5 M21 16 V21 M21 21 H16 M13.5 21 H10.5 M8 21 H3 M3 21 V16 M3 13.5 V10.5 M3 8 V3</StreamGeometry>
  <StreamGeometry x:Key="IconFloodFill">M11 4.5 L17.9 11.4 A1.5 1.5 0 0 1 17.9 13.6 L12.1 19.4 A1.5 1.5 0 0 1 9.9 19.4 L4.1 13.6 A1.5 1.5 0 0 1 4.1 11.4 Z M4.8 5.3 L10.2 10.7 M20 14.8 C19.4 16.5 18 17.4 18 19 A2 2 0 0 0 22 19 C22 17.4 20.6 16.5 20 14.8 Z</StreamGeometry>
  <StreamGeometry x:Key="IconSpawn">M9 7 A3 3 0 1 1 15 7 A3 3 0 1 1 9 7 M5.5 20 C5.5 15.5 8.2 13.5 12 13.5 C15.8 13.5 18.5 15.5 18.5 20</StreamGeometry>
  <StreamGeometry x:Key="IconWarp">M4 8 H15 M12 5 L15 8 L12 11 M20 16 H9 M12 13 L9 16 L12 19</StreamGeometry>
  <StreamGeometry x:Key="IconClose">M6 6 L18 18 M18 6 L6 18</StreamGeometry>

  <!--
    Icon-only toolbar button. Content is the icon Geometry, so a tool is one line of markup
    and the Viewbox/stroke plumbing lives here once.
  -->
  <ControlTheme x:Key="ToolButton" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource EditorMutedTextBrush}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <!-- The fixed 24x24 Canvas is what keeps the set consistent: a Viewbox on its own
               would scale each icon up to its own bounds, so a short glyph would outgrow a tall one. -->
          <Viewbox Width="18" Height="18" Stretch="Uniform">
            <Canvas Width="24" Height="24">
              <Path Data="{TemplateBinding Content}"
                    Stroke="{TemplateBinding Foreground}"
                    StrokeThickness="2"
                    StrokeLineCap="Round"
                    StrokeJoin="Round" />
            </Canvas>
          </Viewbox>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource EditorHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource EditorTextBrush}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource EditorAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="^:checked:pointerover">
      <Setter Property="Background" Value="{DynamicResource EditorAccentHoverBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </ControlTheme>

  <!-- Icon-only tab close button: same 24x24 grid and stroke weight as the toolbar set. -->
  <ControlTheme x:Key="TabCloseButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource EditorMutedTextBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Viewbox Width="10" Height="10" Stretch="Uniform">
            <Canvas Width="24" Height="24">
              <Path Data="{StaticResource IconClose}"
                    Stroke="{TemplateBinding Foreground}"
                    StrokeThickness="2"
                    StrokeLineCap="Round" />
            </Canvas>
          </Viewbox>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource EditorHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource EditorTextBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource EditorPanelBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
