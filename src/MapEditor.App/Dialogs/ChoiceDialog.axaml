<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MapEditor.App.Dialogs.ChoiceDialog"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="16" MinWidth="320">
        <TextBlock Name="MessageText" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="PrimaryButton" Classes="accent" MinWidth="84" IsDefault="True"/>
            <Button Name="SecondaryButton" MinWidth="84"/>
            <Button Name="TertiaryButton" MinWidth="84" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
