<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MapEditor.App.Dialogs.ErrorDialog"
        Title="Error"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12" Spacing="12" MinWidth="300">
        <TextBlock Name="MessageText" TextWrapping="Wrap"/>
        <Button Name="OkButton" Content="OK" MinWidth="80" HorizontalAlignment="Right" IsDefault="True" IsCancel="True"/>
    </StackPanel>
</Window>
